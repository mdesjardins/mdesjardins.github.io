#!/bin/bash
#
# Stages the built site for the FreeDOS web farm. DOS only understands 8.3
# filenames, so every deployed file gets a short name, recorded in
# dosnames.txt. Names are only ever appended to that file, so a file keeps
# its short name forever, even after new posts are added. Also writes a
# Caddy map from the original long URLs to the short names, so the farm
# answers on exactly the same URLs as GitHub Pages.
#
# Run after ./build. Then `sudo dosweb-publish` puts it live.
#
set -euo pipefail

DOS_HTDOCS=${DOS_HTDOCS:-/srv/dosweb/htdocs}
CADDY_MAP=${CADDY_MAP:-/srv/dosweb/blog.map}
NAMES_FILE=dosnames.txt

cd "$(dirname "$0")"

# Everything GitHub Pages would serve: tracked or about-to-be-added files,
# minus dotfiles, _posts, _templates and the blog's own scripts.
deployable_files() {
    git ls-files -co --exclude-standard |
        grep -vE '^[._]|/\.' |
        grep -vxE 'build|build-dos|clean|newpost|publish|CNAME|dosnames\.txt' |
        while IFS= read -r f; do [ -f "$f" ] && echo "$f"; done |
        LC_ALL=C sort -u
}

# DOS extension: the obvious 3-letter form, otherwise the first 3 characters.
dos_extension() {
    case "${1,,}" in
        html) echo HTM ;;
        jpeg) echo JPG ;;
        woff) echo WOF ;;
        *)    echo "${1:0:3}" | tr a-z A-Z ;;
    esac
}

# Short name for one path, unique among everything in USED. Directories
# must already be 8.3 (posts, images); only the filename is shortened.
dos_name() {
    local long=$1 dir="" file stem ext="" base n prefix candidate
    file=${long##*/}
    [[ $long == */* ]] && dir="$(echo "${long%/*}" | tr a-z A-Z)/"
    stem=$file
    if [[ $file == *.* ]]; then
        stem=${file%.*}
        ext=.$(dos_extension "${file##*.}")
    fi
    # Posts start with their date; the slug is the recognisable part.
    stem=$(echo "$stem" | sed -E 's/^[0-9]{4}-[0-9]{2}-[0-9]{2}-//' | tr -cd 'A-Za-z0-9' | tr a-z A-Z)
    [ -n "$stem" ] || stem=FILE

    if (( ${#stem} <= 8 )) && [ -z "${USED[$dir$stem$ext]:-}" ]; then
        echo "$dir$stem$ext"
        return
    fi
    for (( n = 1; ; n++ )); do
        prefix=${stem:0:$(( 8 - ${#n} - 1 ))}
        candidate="$dir$prefix~$n$ext"
        [ -z "${USED[$candidate]:-}" ] && { echo "$candidate"; return; }
    done
}

# Load the existing names, then assign names to new files in sorted order
# (which is date order for posts).
declare -A SHORT USED
if [ -f "$NAMES_FILE" ]; then
    while IFS=$'\t' read -r long short; do
        [[ -z $long || $long == \#* ]] && continue
        SHORT[$long]=$short
        USED[$short]=1
    done < "$NAMES_FILE"
else
    printf '# Long path -> DOS 8.3 path, maintained by build-dos. Append only:\n# changing a line changes that file'"'"'s URL on the DOS farm.\n' > "$NAMES_FILE"
fi

mapfile -t FILES < <(deployable_files)
for long in "${FILES[@]}"; do
    if [[ $long =~ [[:space:]\"\'{}#] ]]; then
        echo "can't map '$long': whitespace, quotes, braces and # break the Caddy map" >&2
        exit 1
    fi
    [ -n "${SHORT[$long]:-}" ] && continue
    short=$(dos_name "$long")
    SHORT[$long]=$short
    USED[$short]=1
    printf '%s\t%s\n' "$long" "$short" >> "$NAMES_FILE"
    echo "new DOS name: $long -> $short"
done

# Stage the short-named tree next to the old one, then swap it in.
STAGE="$DOS_HTDOCS.new"
rm -rf "$STAGE"
mkdir -p "$STAGE"
for long in "${FILES[@]}"; do
    short=${SHORT[$long]}
    mkdir -p "$STAGE/$(dirname "$short")"
    cp -p "$long" "$STAGE/$short"
done

# Caddy map entries: the long URL, the extensionless URL GitHub Pages also
# answers on, and directory URLs for index pages.
MAP_TMP="$CADDY_MAP.new"
{
    echo "# Generated by build-dos from dosnames.txt. Do not edit."
    for long in "${FILES[@]}"; do
        short=/${SHORT[$long]}
        echo "/$long $short"
        if [[ $long == *.html ]]; then
            echo "/${long%.html} $short"
        fi
        if [[ $long == index.html ]]; then
            echo "/ $short"
        elif [[ $long == */index.html ]]; then
            echo "/${long%index.html} $short"
            echo "/${long%/index.html} $short"
        fi
    done
} > "$MAP_TMP"

if [ -d "$DOS_HTDOCS" ]; then
    mv "$DOS_HTDOCS" "$DOS_HTDOCS.old"
fi
mv "$STAGE" "$DOS_HTDOCS"
rm -rf "$DOS_HTDOCS.old"
mv "$MAP_TMP" "$CADDY_MAP"
echo "staged ${#FILES[@]} files in $DOS_HTDOCS, map in $CADDY_MAP"
